digraph G {
  graph [fontname="Arial", bgcolor="white", labeljust=l, labelloc=t, fontsize=19, fontcolor="#18344e", pad=0.35, nodesep=0.65, ranksep=0.90, splines=polyline, overlap=false, concentrate=false, outputorder=edgesfirst];
  graph [label=<Panorama dei sistemi target: domini di guasto separati<BR/><FONT POINT-SIZE="12">Architettura proposta | non è un sistema in esercizio</FONT><BR/><FONT POINT-SIZE="10" COLOR="#496377">Notazione in stile C4 resa con Graphviz (non Structurizr). Riquadro: nome, [tipo C4: tecnologia] | sito, owner; nel file SVG la descrizione compare al passaggio del mouse.</FONT>>, rankdir=LR];
  node [shape=box, style="rounded,filled", fontname="Arial"];
  edge [fontname="Arial", fontsize=8.5, color="#60778c", fontcolor="#526478", arrowsize=0.67, penwidth=1.3];
  subgraph cluster_0 {
    label="Piattaforma multisito"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "idp" [label="Internal Developer Platform\n[Sistema software: Backstage,\nGitLab, OpenTofu, CAPV, Flux,\nKyverno, ESO] | più siti\nOwner: Platform Engineering", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Piattaforma self-service su Central e South."];
    "onprem" [label="Flotta VMware e Kubernetes\n[Sistema software: VMware vSphere\n+ Kubernetes, 30 cluster] |\nCentral/South\nOwner: Platform Engineering", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Control plane indipendenti per sito; nessun etcd tra siti."];
    "obs" [label="Osservabilità LGTM per sito\nattivo\n[Sistema software: Grafana LGTM\nper sito attivo] | Central/South\nOwner: SRE", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Metriche, log, trace e alerting locali al sito."];
    "gitlab" [label="GitLab Ultimate primario +\nGeo\n[Sistema software: GitLab Ultimate\nprimario (Central) + Geo\nsecondario (South)] |\nCentral/South\nOwner: Platform Engineering", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="SCM, CI, registry e policy di sicurezza."];
  }
  subgraph cluster_1 {
    label="North: backup e archivio di audit (seconda copia di audit in South, ADR 0010)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "audit" [label="Backup e archivio di audit\nimmutabile\n[Sistema software: Compatibile S3,\nObject Lock in compliance mode] |\nNorth\nOwner: Data Engineering (storage);\nadmin della retention designato\ndal CISO", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Backup e archivio di audit immutabile in North; seconda copia di audit in South (ADR 0010)."];
  }
  subgraph cluster_2 {
    label="Dipendenze del cliente"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "security" [label="IAM / PKI / secret manager\naziendali\n[Sistema esterno: IdP, PKI, secret\nmanager, HSM/KMS per sito] | più\nsiti\nOwner: Network Security", fillcolor="#edf4f9", color="#3b667c", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Servizi abilitanti istanziati in Central e South (ADR 0011)."];
    "data" [label="Servizi dati SQL / NoSQL\n[Sistema esterno: SQL/NoSQL con\nreplica tra siti] | Central/South\nOwner: Data Engineering", fillcolor="#edf4f9", color="#3b667c", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Servizi dati di produzione; repliche in South per il DR."];
    "firewall" [label="Firewall tra siti di Network\nSecurity\n[Sistema esterno: Firewall di\nNetwork Security] | più siti\nOwner: Network Security", fillcolor="#edf4f9", color="#3b667c", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Tutto il traffico tra siti; flussi dichiarati esplicitamente (docs/12)."];
  }
  "dev" [label="Sviluppatori di business\n[Persona]", fillcolor="#fff8ec", color="#a67327", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Team di business che richiedono e usano ambienti di sviluppo e test."];
  "ops" [label="Operations e sicurezza\n[Persona]", fillcolor="#fff8ec", color="#a67327", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Personale operations e sicurezza dei quattro team del cliente; oggi si affida ai check black-box."];
  "dev" -> "idp" [label="Richiesta\nself-service", color="#60778c", style="solid"];
  "ops" -> "obs" [label="SLO/alerting", color="#60778c", style="solid"];
  "idp" -> "gitlab" [label="Richieste protette /\nCI", color="#60778c", style="solid"];
  "gitlab" -> "onprem" [label="Stato desiderato\nGitOps firmato", color="#60778c", style="solid"];
  "onprem" -> "obs" [label="Telemetria", color="#60778c", style="solid"];
  "onprem" -> "data" [label="Dipendenze dai dati", color="#60778c", style="solid"];
  "onprem" -> "audit" [label="Audit\npiattaforma/K8s via\nrelay dedicato (non\nvia LGTM)", color="#60778c", style="solid"];
  "idp" -> "security" [label="OIDC/PKI/secret", color="#60778c", style="solid"];
  "data" -> "audit" [label="Backup protetti", color="#60778c", style="solid"];
  "gitlab" -> "firewall" [label="Replica Geo previa\napprovazione", color="#60778c", style="solid"];
  "firewall" -> "audit" [label="Ogni flusso tra siti\nsu regole approvate\n(docs/12)", color="#60778c", style="solid"];
}
