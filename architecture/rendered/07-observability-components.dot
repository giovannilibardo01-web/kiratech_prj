digraph G {
  graph [fontname="Arial", bgcolor="white", labeljust=l, labelloc=t, fontsize=19, fontcolor="#18344e", pad=0.35, nodesep=0.65, ranksep=0.90, splines=polyline, overlap=false, concentrate=false, outputorder=edgesfirst];
  graph [label=<Componenti di osservabilità: un sito attivo (Central e South identici)<BR/><FONT POINT-SIZE="12">Architettura proposta | non è un sistema in esercizio</FONT><BR/><FONT POINT-SIZE="10" COLOR="#496377">Notazione in stile C4 resa con Graphviz (non Structurizr). Riquadro: nome, [tipo C4: tecnologia] | sito, owner; nel file SVG la descrizione compare al passaggio del mouse.</FONT>>, rankdir=LR];
  node [shape=box, style="rounded,filled", fontname="Arial"];
  edge [fontname="Arial", fontsize=8.5, color="#60778c", fontcolor="#526478", arrowsize=0.67, penwidth=1.3];
  subgraph cluster_0 {
    label="Sorgenti e collector"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "app" [label="Workload e sorgenti\nKubernetes\n[Componente: kubelet,\nkube-state-metrics, SDK OTel,\naudit di kube-apiserver]\nOwner: Team dei workload /\nPlatform Eng.", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Endpoint delle metriche, log dei container, span OTLP ed eventi di audit di ogni cluster del sito."];
    "alloy" [label="Collector Alloy (della\npiattaforma)\n[Componente: Grafana Alloy\n(DaemonSet + collector di\ncluster)]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Ricava il namespace dai metadati Kubernetes, associa il namespace al tenant tramite il registry, bufferizza le metriche nel WAL."];
  }
  subgraph cluster_1 {
    label="Confine dei tenant (scrittura e lettura)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "gateway" [label="Telemetry gateway\n(scrittura)\n[Componente: Reverse proxy mTLS]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Autentica i certificati per cluster, accetta le coppie (cluster, tenant) elencate nel registry, rimuove gli header di tenant inviati dal client, applica i limiti."];
    "querygw" [label="Query gateway (lettura)\n[Componente: Reverse proxy con\nvalidazione OIDC]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Valida il token inoltrato, associa i gruppi dell'IdP ai tenant consentiti, imposta X-Scope-OrgID, registra ogni query."];
  }
  subgraph cluster_2 {
    label="Servizi LGTM in HA (SRE)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "mimir" [label="Mimir distributor / ingester\n/ querier\n[Componente: Grafana Mimir 3.x\ningest storage]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Metriche dei tenant t-<team>, platform (30 giorni) e capacity (395 giorni)."];
    "loki" [label="Loki distributor / ingester\n/ querier / compactor\n[Componente: Grafana Loki 3.x]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Log operativi a 30 giorni per tenant; il tenant security è una copia ricercabile a 30 giorni, non il registro di audit."];
    "tempo" [label="Tempo distributor /\nblock-builder / live-store\n[Componente: Grafana Tempo 3.x a\nmicroservizi]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Trace a 7 giorni per tenant, campionamento esplicito."];
    "grafana" [label="Grafana (un'organizzazione\nper team)\n[Componente: Grafana OSS,\nprovisioning da Git]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Dashboard ed Explore; i data source inoltrano il token OIDC dell'utente al query gateway."];
    "alert" [label="Ruler + Alertmanager\n[Componente: Ruler Mimir/Loki,\nAlertmanager replicato]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Regole per tenant di recording, burn rate degli SLO e capacità federata; instradamento ai quattro team."];
  }
  subgraph cluster_3 {
    label="Servizi di supporto (con il team fornitore)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "bucket" [label="Object storage (un bucket\nper segnale)\n[Archivio dati: Compatibile S3,\nlocale al sito]\nOwner: Data Engineering", fillcolor="#f5eafd", color="#835a9f", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Blocchi, chunk e stato dei ruler; almeno tre fault domain di storage."];
    "broker" [label="Broker di ingest\n[Archivio dati: Compatibile Kafka,\n3 broker RF3]\nOwner: Data Engineering", fillcolor="#f5eafd", color="#835a9f", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Percorso di scrittura durevole per l'ingest storage di Mimir e i microservizi di Tempo."];
    "caches" [label="Cache di query / indice /\nchunk\n[Archivio dati: Memcached]\nOwner: SRE", fillcolor="#f5eafd", color="#835a9f", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Solo prestazioni; la perdita rallenta le query."];
    "pv" [label="Volumi persistenti\n[Archivio dati: Storage class CSI\ndel sito]\nOwner: Platform Engineering", fillcolor="#f5eafd", color="#835a9f", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Dischi di ingester e store-gateway, WAL di Loki, WAL dei collector e spool di audit."];
    "dbmeta" [label="Database dei metadati\nGrafana\n[Archivio dati: PostgreSQL HA]\nOwner: Data Engineering", fillcolor="#f5eafd", color="#835a9f", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Utenti, organizzazioni e preferenze; le dashboard si ricreano da Git con il provisioning."];
    "oidc" [label="IdP e PKI locali al sito\n[Sistema esterno: OIDC + CA per\nsito]\nOwner: Network Security", fillcolor="#edf4f9", color="#3b667c", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Login utente, validazione dei token e certificati dei collector senza Central."];
  }
  subgraph cluster_4 {
    label="Fuori banda: audit e metamonitoring"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "auditrelay" [label="Relay di audit (con ACK)\n[Componente: Relay dedicato con\nspool su disco] | Central/South\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Separato dall'ingest LGTM; numeri di sequenza, conferma di ricezione e manifest di hash."];
    "auditarch" [label="Archivio di audit immutabile\ndi North\n[Archivio dati: Compatibile S3 con\nObject Lock]\nOwner: Data Engineering (storage);\nadmin della retention designato\ndal CISO", fillcolor="#f5eafd", color="#835a9f", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Archivio a 400 giorni degli eventi di audit di piattaforma e Kubernetes, con manifest di integrità."];
    "meta" [label="Metamonitoring tra siti\n[Componente: Prometheus nell'altro\nsito + black-box legacy]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Raccoglie via F-10 lo stato di salute dell'LGTM di questo sito e verifica la freschezza dei canary."];
    "deadman" [label="Ricevitore dead-man's switch\n(altro sito)\n[Componente: Ricevitore di\nheartbeat + canale di notifica\nseparato]\nOwner: SRE", fillcolor="#e4f3f2", color="#247b72", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Chiama il reperibile SRE quando si interrompe l'heartbeat Watchdog di questo sito."];
  }
  "team" [label="Team in reperibilità (SRE,\nPlatform, Data, Network\nSecurity)\n[Persona]", fillcolor="#fff8ec", color="#a67327", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Ricevono paging e ticket con i runbook."];
  "app" -> "alloy" [label="Scrape / tail dei\nlog / OTLP;\nnamespace risolto\ndal collector", color="#60778c", style="solid"];
  "alloy" -> "gateway" [label="mTLS con cert per\ncluster; stream per\ntenant; WAL", color="#60778c", style="solid"];
  "gateway" -> "mimir" [label="Remote-write; tenant\nimpostato dal\ngateway", color="#60778c", style="solid"];
  "gateway" -> "loki" [label="Push dei log; tenant\nimpostato dal\ngateway", color="#60778c", style="solid"];
  "gateway" -> "tempo" [label="OTLP; tenant\nimpostato dal\ngateway", color="#60778c", style="solid"];
  "mimir" -> "bucket" [label="Blocchi TSDB: tenant\n30 gg, capacity 395\ngg", color="#60778c", style="solid"];
  "loki" -> "bucket" [label="Chunk + indice TSDB:\n30 gg", color="#60778c", style="solid"];
  "tempo" -> "bucket" [label="Blocchi Parquet: 7\ngg", color="#60778c", style="solid"];
  "mimir" -> "caches" [label="Cache di query /\nindice / chunk", color="#60778c", style="solid"];
  "loki" -> "caches" [label="Cache di query /\nchunk", color="#60778c", style="solid"];
  "grafana" -> "querygw" [label="Query + token OIDC\ninoltrato", color="#60778c", style="solid"];
  "querygw" -> "mimir" [label="PromQL limitato al\ntenant", color="#60778c", style="solid"];
  "querygw" -> "loki" [label="LogQL limitato al\ntenant", color="#60778c", style="solid"];
  "mimir" -> "alert" [label="Valutazione delle\nregole per tenant", color="#60778c", style="solid"];
  "alert" -> "team" [label="Paging / ticket +\nrunbook", color="#60778c", style="solid"];
  "app" -> "auditrelay" [label="Audit API K8s /\nGitLab / vault\n(percorso separato)", color="#60778c", style="solid"];
  "meta" -> "gateway" [label="Freschezza canary +\nprobe di salute\n(F-10)", color="#60778c", style="solid"];
  "meta" -> "team" [label="Paging indipendente,\ncanale separato", color="#60778c", style="solid"];
  "grafana" -> "dbmeta" [label="Utenti,\norganizzazioni,\npreferenze", color="#60778c", style="solid"];
  "auditrelay" -> "auditarch" [label="ACK + manifest di\nhash (F-04)", color="#60778c", style="solid"];
  "mimir" -> "broker" [label="Partizioni\ndell'ingest storage", color="#60778c", style="solid"];
  "tempo" -> "broker" [label="Percorso di\nscrittura delle\ntrace", color="#60778c", style="solid"];
  "querygw" -> "tempo" [label="TraceQL limitato al\ntenant", color="#60778c", style="solid"];
  "querygw" -> "oidc" [label="Validazione del\ntoken", color="#60778c", style="solid"];
  "grafana" -> "oidc" [label="Login utente (OIDC)", color="#60778c", style="solid"];
  "alert" -> "deadman" [label="Heartbeat Watchdog", color="#60778c", style="solid"];
  "deadman" -> "team" [label="Paging se\nl'heartbeat si ferma", color="#60778c", style="solid"];
  "mimir" -> "pv" [label="Dischi ingester /\nstore-gateway", color="#60778c", style="solid"];
  "loki" -> "pv" [label="WAL / dischi\ningester", color="#60778c", style="solid"];
}
