digraph G {
  graph [fontname="Arial", bgcolor="white", labeljust=l, labelloc=t, fontsize=19, fontcolor="#18344e", pad=0.35, nodesep=0.65, ranksep=0.90, splines=polyline, overlap=false, concentrate=false, outputorder=edgesfirst];
  graph [label=<Panorama dei sistemi attuale: noto e non noto<BR/><FONT POINT-SIZE="12">Architettura proposta | non è un sistema in esercizio</FONT><BR/><FONT POINT-SIZE="10" COLOR="#496377">Notazione in stile C4 resa con Graphviz (non Structurizr). Riquadro: nome, [tipo C4: tecnologia] | sito, owner; nel file SVG la descrizione compare al passaggio del mouse.</FONT>>, rankdir=LR];
  node [shape=box, style="rounded,filled", fontname="Arial"];
  edge [fontname="Arial", fontsize=8.5, color="#60778c", fontcolor="#526478", arrowsize=0.67, penwidth=1.3];
  subgraph cluster_0 {
    label="North (backup)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "north-old" [label="Servizio di backup off-site\n[Sistema software: Servizio di\nbackup, prodotto ignoto] | North\nOwner: Data Engineering", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Sito di backup off-site."];
  }
  subgraph cluster_1 {
    label="Central (produzione)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "git-single" [label="GitLab self-managed a\nistanza singola\n[Sistema software: GitLab\nUltimate, self-managed] | Central\nOwner: Platform Engineering", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Istanza singola in Central; oggi senza Geo."];
    "central-old" [label="Produzione critica per il\nbusiness\n[Sistema software] | Central", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Hosting della produzione critica per il business."];
  }
  subgraph cluster_2 {
    label="South (non produzione)"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "south-old" [label="Workload non di produzione\n[Sistema software] | South", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Sito di deployment secondario, di norma non di produzione."];
    "golden-existing" [label="Golden path dei namespace in\nSouth (in corso)\n[Sistema software: RBAC, quote,\ndefault-deny, PSS, policy engine,\nexternal secrets, GitLab CI] |\nSouth\nOwner: Ingegnere senior Kiratech", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Attività sul golden path dei namespace in South."];
  }
  subgraph cluster_3 {
    label="Parco / collocazione non verificata"; style="rounded,dashed"; color="#b3c2d3";    fontname="Arial"; fontsize=11; fontcolor="#496377"; margin=16;
    "vm" [label="Parco VMware\n[Sistema esterno: VMware vSphere]\n| più siti\nOwner: owner VMware del cliente", fillcolor="#edf4f9", color="#3b667c", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Parco hypervisor sui tre siti; topologia vCenter per sito da confermare (Q-14)."];
    "oldk8s" [label="Cluster Kubernetes creati a\nmano\n[Sistema software: Kubernetes,\nversioni miste] | più siti\nOwner: Vari team del cliente", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Cluster creati a mano senza una baseline comune; collocazione e versioni da censire (Q-03)."];
    "oldmonitor" [label="Monitor ping / HTTP legacy\n[Sistema software: Strumento\nping/HTTP legacy] | sito non noto\nOwner: SRE", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Check black-box che non si possono spegnere da un giorno all'altro; collocazione ignota (Q-13)."];
    "ref-app" [label="App di riferimento\nthree-tier + LGTM locale (in\ncorso)\n[Sistema software: Prometheus,\nLoki, Grafana, Alloy su un solo\ncluster] | sito non noto\nOwner: Ingegnere Kiratech", fillcolor="#e8f0ff", color="#3366a8", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Attività sull'applicazione di riferimento three-tier."];
  }
  "dev" [label="Sviluppatori di business\n[Persona]", fillcolor="#fff8ec", color="#a67327", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Team di business che richiedono e usano ambienti di sviluppo e test."];
  "ops" [label="Operations e sicurezza\n[Persona]", fillcolor="#fff8ec", color="#a67327", fontcolor="#182c3d", penwidth=1.4, fontsize=11, width=2.4, margin="0.16,0.12", tooltip="Personale operations e sicurezza dei quattro team del cliente; oggi si affida ai check black-box."];
  "dev" -> "oldk8s" [label="Richieste manuali", color="#60778c", style="solid"];
  "ops" -> "oldmonitor" [label="Controlla gli alert", color="#60778c", style="solid"];
  "oldmonitor" -> "central-old" [label="Ping/HTTP", color="#60778c", style="solid"];
  "oldmonitor" -> "south-old" [label="Ping/HTTP", color="#60778c", style="solid"];
  "git-single" -> "central-old" [label="Dipendenza attuale\nper sorgenti/release", color="#60778c", style="solid"];
  "oldk8s" -> "vm" [label="Ospitati su", color="#60778c", style="solid"];
  "central-old" -> "north-old" [label="Backup (dettagli\nignoti)", color="#b25354", style="dashed"];
  "ref-app" -> "oldk8s" [label="Prova su un solo\ncluster", color="#60778c", style="solid"];
  "golden-existing" -> "south-old" [label="Provisioning dei\nnamespace", color="#60778c", style="solid"];
  "oldk8s" -> "central-old" [label="Workload\n(collocazione\nignota)", color="#60778c", style="solid"];
}
